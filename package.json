{
  "name": "pos-system",
  "version": "1.0.0",
  "description": "Point of Sale System with Barcode Scanning",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "test": "node --test",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "init-db": "node --env-file-if-exists=.env init_db.js",
    "reset:dev": "node --env-file-if-exists=.env scripts/reset-dev.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js"
  },
  "dependencies": {
    "express": "^4.22.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
